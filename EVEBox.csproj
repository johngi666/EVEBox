<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- 基础配置 -->
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<Nullable>disable</Nullable>
		<ApplicationIcon>icon.ico</ApplicationIcon>
		<AssemblyTitle>EVE BOX</AssemblyTitle>
		<AssemblyName>EVE BOX</AssemblyName>
		<RootNamespace>EVEBox</RootNamespace>

		<!-- 发布配置：生成单个文件 -->
		<PublishSingleFile>true</PublishSingleFile>
		<SelfContained>true</SelfContained>
		<PublishReadyToRun>true</PublishReadyToRun>
		<PublishTrimmed>false</PublishTrimmed>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

		<!-- 排除测试目录，避免被主项目编译 -->
		<DefaultItemExcludes>$(DefaultItemExcludes);tests\**</DefaultItemExcludes>
	</PropertyGroup>

	<!--
		各功能模块自带的内置模板：直接编译进 exe（EmbeddedResource），程序启动时由
		NeiZhiMoBanZiYuan 按需释放到 文档\EVE\templates\<模块>\ 下。
		这样发布包只需要一个 exe，自动更新（只替换主程序）也不会丢模板。
		LogicalName 前缀 EVEBoxTemplates/ 供运行时识别。
	-->
	<ItemGroup>
		<EmbeddedResource Include="OtherTools\PeiZhiFangAnDaoRu\MoBan\**\*">
			<LogicalName>EVEBoxTemplates/PeiZhiFangAnDaoRu/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="OtherTools\ZhongCaiMoBan\MoBan\**\*">
			<LogicalName>EVEBoxTemplates/ZhongCaiMoBan/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="OtherTools\ZhuangPeiFangAn\MoBan\**\*">
			<LogicalName>EVEBoxTemplates/ZhuangPeiFangAn/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="OtherTools\ZongLanMoBan\MoBan\**\*">
			<LogicalName>EVEBoxTemplates/ZongLanMoBan/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
		</EmbeddedResource>
	</ItemGroup>
</Project>
