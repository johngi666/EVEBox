<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- 基础配置 -->
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<Nullable>disable</Nullable>
		<ApplicationIcon>icon.ico</ApplicationIcon>
		<AssemblyTitle>EVE BOX</AssemblyTitle>
		<AssemblyName>EVE BOX</AssemblyName>
		<RootNamespace>EVEBox</RootNamespace>

		<!-- 发布配置：生成单个文件 -->
		<PublishSingleFile>true</PublishSingleFile>
		<SelfContained>true</SelfContained>
		<!--
			PublishReadyToRun 实测不划算（2026-10-02 在本机对比）：
			  开启: exe 175.4 MB，发布耗时 37.8 秒，启动平均 314 ms
			  关闭: exe 159.3 MB，发布耗时  2.6 秒，启动平均 327 ms
			即用 16.1 MB 体积 + 14 倍打包时间，只换到约 13 ms 启动差异（在噪声范围内）。
			用户解压即用，体积与下载速度更重要，故关闭。
			若日后确实需要更快冷启动，改回 true 即可，其余不变。
		-->
		<PublishReadyToRun>false</PublishReadyToRun>
		<PublishTrimmed>false</PublishTrimmed>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

		<!-- 排除测试目录与工具目录，避免被主项目编译 -->
		<DefaultItemExcludes>$(DefaultItemExcludes);tests\**;tools\**</DefaultItemExcludes>
	</PropertyGroup>

	<!--
		各功能模块自带的内置模板：直接编译进 exe（EmbeddedResource），程序启动时由
		NeiZhiMoBanZiYuan 按需释放到 文档\EVE\templates\<模块>\ 下。
		这样发布包只需要一个 exe，自动更新（只替换主程序）也不会丢模板。
		LogicalName 前缀 EVEBoxTemplates/ 供运行时识别。
	-->
	<ItemGroup>
		<EmbeddedResource Include="OtherTools\ConfigSchemeImport\MoBan\**\*">
			<LogicalName>EVEBoxTemplates/ConfigSchemeImport/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="OtherTools\PlantingTemplate\MoBan\**\*">
			<LogicalName>EVEBoxTemplates/PlantingTemplate/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="OtherTools\FittingPlan\MoBan\**\*">
			<LogicalName>EVEBoxTemplates/FittingPlan/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="OtherTools\OverviewTemplate\MoBan\**\*">
			<LogicalName>EVEBoxTemplates/OverviewTemplate/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

	<!--
		星系间距查询的三服星系数据（来源 c3q.cc，数据不常变动）：同样直接编译进 exe（EmbeddedResource），
		运行时优先读内置数据，无需联网下载、不生成文件；仅内置资源缺失时才回退网络。
		LogicalName 前缀 EVEBoxSystemDistance/ 供运行时识别。
	-->
	<ItemGroup>
		<EmbeddedResource Include="OtherTools\SystemDistance\Data\**\*.txt">
			<LogicalName>EVEBoxSystemDistance/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
		</EmbeddedResource>
	</ItemGroup>
</Project>
